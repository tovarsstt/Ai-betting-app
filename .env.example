VITE_GEMINI_API_KEY=YOUR_API_KEY_HERE

# FTGMYTHOS local model (optional — set to enable, leave blank to skip)
LOCAL_MYTHOS_URL=http://localhost:8420
LOCAL_MYTHOS_N_LOOPS=8
# LOCAL_MYTHOS_ENABLED=true   # alternative flag if URL not set

# CLV capture — stamps the closing line on pending picks every 15 min (needs the
# Odds API). OFF by default so dev/test never hit the API (CLAUDE.md). Turn on in
# production to grade closing-line value: GET /api/ledger/report shows the CLV.
# ENABLE_CLV_CAPTURE=true

# Tennis rank refresh — pulls official ATP/WTA ranks (ESPN, free) every Monday 06:00.
# ON by default (no Odds-API quota used). Set true to disable the weekly cron.
# DISABLE_RANK_REFRESH=true

# Stake odds via OddsPapi (free tier 250 req/month) — Stake has no official API
# and is not on the-odds-api. Sign up at oddspapi.io, then:
#   python3 scripts/fetch_stake_odds.py --discover   (find Stake's bookmaker key)
#   python3 scripts/fetch_stake_odds.py --raw        (verify the market schema)
# Without a key, every pick still carries min_odds: bet on Stake only if its
# on-screen price >= that floor.
# ODDSPAPI_KEY=YOUR_KEY_HERE
# ODDSPAPI_STAKE_KEY=stake
