{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "caveman-locks",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "caveman-backend",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "server.ts"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "edge-api",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/edge_api.py"
      ],
      "port": 8001,
      "autoPort": false
    },
    {
      "name": "math-engine",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/math_engine.py"
      ],
      "port": 8002,
      "autoPort": false
    }
  ]
}